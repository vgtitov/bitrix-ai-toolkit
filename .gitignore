# Зависимости
/vendor/
/node_modules/
composer.lock

# Демо-артефакты (локальные)
/demo/*.cast
/demo/*.gif
/demo/*.mov
/demo/*.mp4
/demo/workspace/

# Локальные конфиги/секреты
.env
*.local
.claude/settings.local.json

# Кэш инструментов
.phpunit.result.cache
.php-cs-fixer.cache
/.phpstan/

# Локализация под конкретную организацию (не в публичное ядро)
# ВАЖНО: config/local/ — слой компании (креды, версии, конвенции). В публичный репо не попадает.
config/local/*
!config/local/.gitkeep
core/skills/*/references/local/
/config/*.local.*

# ОС
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Персональные конфиги (создаются onboard из *.example.*)
/config/checks.toml
/config/version-stack.toml

# Внешние официальные источники (клонируются scripts/fetch_official_docs.sh)
/.ai/
