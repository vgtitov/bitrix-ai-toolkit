#!/bin/sh
# bitrix-guard (ОПЦИОНАЛЬНЫЙ): проверяет staged *.php на обращение к БД в цикле (N+1).
# По умолчанию режим WARN — показывает находки, но НЕ блокирует коммит (не ухудшает жизнь разработчику).
# Строгий гейт (block) — осознанно: config/checks.toml [checks.n1_guard].mode="block" или env BITRIX_AI_CHECKS=block.
# Глобально выключить: BITRIX_AI_CHECKS=off. Аналог bsl-guard из bsl-ai-toolkit, но опциональный.
# Кроссплатформенно (sh; на Windows — git-bash). Явно указать toolkit — env BITRIX_TOOLKIT_DIR.

files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -iE '\.php$' | grep -ivE '/(vendor|bitrix)/')
[ -z "$files" ] && exit 0

tk=""
for cand in "$BITRIX_TOOLKIT_DIR" "$(dirname "$0")/.." "$(git rev-parse --show-toplevel 2>/dev/null)"; do
  [ -n "$cand" ] && [ -f "$cand/scripts/bitrix_guard.py" ] && tk="$cand" && break
done
[ -z "$tk" ] && exit 0   # detector не найден — не мешаем чужим репозиториям

py=python3
command -v "$py" >/dev/null 2>&1 || py=python
command -v "$py" >/dev/null 2>&1 || exit 0

# режим: off | warn | block (дефолт warn)
mode=$("$py" "$tk/scripts/checks_config.py" n1_guard 2>/dev/null)
[ -z "$mode" ] && mode=warn
[ "$mode" = "off" ] && exit 0

# shellcheck disable=SC2086
out=$(echo "$files" | xargs "$py" "$tk/scripts/bitrix_guard.py" 2>/dev/null)
rc=$?
[ "$rc" -eq 0 ] && exit 0   # находок нет

echo "$out" >&2
if [ "$mode" = "block" ]; then
  echo "" >&2
  echo "[bitrix-guard] коммит остановлен (режим block): N+1. Переделай пакетно; обойти разово: git commit --no-verify" >&2
  exit 1
fi
echo "" >&2
echo "[bitrix-guard] предупреждение (режим warn): найден N+1 (см. выше). Коммит НЕ блокирован." >&2
echo "  строгий гейт: config/checks.toml [checks.n1_guard].mode=\"block\" (или env BITRIX_AI_CHECKS=block)" >&2
exit 0
