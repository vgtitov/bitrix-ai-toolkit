# Что НЕ должно попадать в образ.
# Критично: персональные конфиги — иначе они «зашьются» в общий образ и переопределят дефолты
# у всех, кто им пользуется. В образе должны быть только *.example.* — режимы задаются через
# env (BITRIX_AI_CHECKS) или томом с конфигом.
config/checks.toml
config/version-stack.toml
config/local/

# Внешние источники (клонируются локально, большие; агенту, а не контейнеру)
.ai/

# Служебное
.git/
.github/
__pycache__/
**/__pycache__/
*.pyc
.DS_Store

# Сгенерированное build.sh (в образе не нужно — там только core/scripts/config/tests)
CLAUDE.md
AGENTS.md
GEMINI.md
.mcp.json
.claude/

# Документация и демо — в образ проверок не нужны
docs/
demo/
adapters/
*.md
