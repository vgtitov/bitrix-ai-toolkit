<?xml version="1.0"?>
<ruleset name="Bitrix-PHPMD"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Сложность и размер кода — то, чего PHPStan НЕ меряет. Битрикс-легаси часто = «функция на 400 строк».
        Установка: composer require --dev phpmd/phpmd
        Прогон:    vendor/bin/phpmd local/classes,local/modules text core/linters/phpmd.xml
        Опционален (как все проверки): не установлен → шаг пропускается.
        Пороги намеренно МЯГКИЕ — цель показать «здесь пора резать», а не завалить легаси красным.
    </description>

    <!-- Размер и сложность -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties><property name="reportLevel" value="12"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties><property name="minimum" value="256"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties><property name="minimum" value="80"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties><property name="minimum" value="800"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties><property name="maxmethods" value="25"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties><property name="minimum" value="8"/></properties>
    </rule>

    <!-- Чистота: неиспользуемое -->
    <rule ref="rulesets/unusedcode.xml/UnusedLocalVariable"/>
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateField"/>
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateMethod"/>
    <!-- UnusedFormalParameter НЕ включаем: Битрикс дёргает обработчики событий с фиксированной сигнатурой,
         часть параметров не используется по определению → сплошные ложные срабатывания. -->

    <!-- Дизайн -->
    <rule ref="rulesets/design.xml/EvalExpression"/>
    <rule ref="rulesets/design.xml/ExitExpression"/>
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties><property name="maximum" value="20"/></properties>
    </rule>

    <!-- Именование: короткие имена в Битрикс-коде норма ($ID, $el, $ob) → мягко -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties><property name="minimum" value="2"/></properties>
    </rule>
    <rule ref="rulesets/naming.xml/ConstantNamingConventions"/>
</ruleset>
