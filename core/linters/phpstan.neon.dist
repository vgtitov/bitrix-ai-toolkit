# phpstan.neon.dist — статанализ PHP под 1С-Битрикс
#
# Зашитая проверка: (1) типы/баги, (2) КОРРЕКТНОСТЬ работы с ядром КОНКРЕТНОЙ ВЕРСИИ,
# (3) устаревшее API ядра (@deprecated). Скопируй в корень проекта как phpstan.neon и настрой пути.
#
# КАК РАБОТАЕТ ПРОВЕРКА ВЕРСИЙ ЯДРА (аналог «режима совместимости» 1С):
#   PHPStan сам ругается «Call to undefined method», если метода нет в ТОЙ версии ядра,
#   которую ты дал ему через scanDirectories. То есть версионность = какое ядро лежит рядом,
#   а не «версионированные стабы» (их в экосистеме нет). Клади распакованное ядро своей версии.
#
# УСТАРЕВШЕЕ API: ядро Битрикс само размечено @deprecated в PHPDoc → phpstan-deprecation-rules
#   автоматически выдаёт «используете устаревший метод ядра». Список вести не нужно.

# РАСШИРЕНИЯ ПОДКЛЮЧАЮТСЯ САМИ — не прописывай includes на vendor вручную.
# Поставь extension-installer, и он зарегистрирует все расширения PHPStan автоматически:
#
#   composer require --dev phpstan/extension-installer \
#       phpstan/phpstan phpstan/phpstan-deprecation-rules phpstan/phpstan-strict-rules
#
# Почему не через includes: PHPStan не умеет условный include — если пакет не установлен,
# анализ падает с «File ... is missing or is not readable» ещё до старта. Проверено.
#
# Кастомные правила toolkit под анти-паттерны Битрикс — раскомментируй и укажи ПУТЬ ОТ КОРНЯ ПРОЕКТА
# (если toolkit склонирован рядом, это может быть ../bitrix-ai-toolkit/core/linters/bitrix-rules.neon):
# includes:
#     - vendor/bitrix-ai-toolkit/core/linters/bitrix-rules.neon

parameters:
    # Уровень: legacy — низкий (1), новый код в /local — 4+. Референс: Habr 961832, spaceonfire/bitrix-tools.
    level: 6

    paths:
        - local/php_interface
        - local/components
        - local/modules
        - local/classes            # PSR-4 \Local\ — основной анализируемый код

    # Ядро НЕ анализируем (оно legacy и чужое), но ДАЁМ PHPStan его ВИДЕТЬ для проверки версий/сигнатур.
    # Замени пути на распакованное ядро СВОЕЙ версии (из bitrix-toolkit/bitrix-ci, env-docker или бэкапа).
    scanDirectories:
        - bitrix/modules/main/lib
        - bitrix/modules/iblock/lib
        - bitrix/modules/catalog/lib
        - bitrix/modules/sale/lib
        - bitrix/modules/highloadblock/lib

    # Стабы — ОПЦИОНАЛЬНО и по умолчанию ВЫКЛЮЧЕНЫ. Основной путь — scanDirectories выше (реальное ядро
    # твоей версии): он точнее стабов. Стабы нужны, только если ядра под рукой нет или надо переопределить
    # типы отдельных функций (напр. LocalRedirect → never), чтобы убрать ложные срабатывания.
    # Как получить — core/linters/stubs/README.md. Раскомментируй, когда файл реально появится:
    # stubFiles:
    #     - core/linters/stubs/bitrix.stub

    # Аннотации ORM под твою версию ядра. Сгенерировать:
    #   php bitrix/modules/main/cli.php orm annotate
    # Раскомментируй, когда файл появится (иначе PHPStan упадёт «file not found»):
    # scanFiles:
    #     - local/php_interface/orm_annotations.php

    # Заморозка legacy-ошибок, чтобы агент работал только с новыми (composer: phpstan --generate-baseline).
    # - phpstan-baseline.neon

    excludePaths:
        - '*/bitrix/*'
        - '*/vendor/*'
        - '*/upload/*'

    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
